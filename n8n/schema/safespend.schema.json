{
  "$comment": "Machine-readable description of the SafeSpend Firestore schema, used by the n8n workflows. Keep in sync with lib/models; test/n8n_schema_test.dart fails if they drift.",
  "version": 1,
  "money": {
    "unit": "paisa",
    "minorPerMajor": 100,
    "note": "All stored amounts are integers in paisa. Workflows and the app talk to users in rupees."
  },
  "keys": {
    "monthKey": "yyyy-MM",
    "dayKey": "yyyy-MM-dd",
    "dayOfMonth": "two digits, e.g. 05",
    "timeBasis": "the user's local date; clients send localDate and timeZoneOffsetMinutes"
  },
  "enums": {
    "CategoryKind": [
      "fixed",
      "flexible",
      "savings"
    ],
    "ExpenseSource": [
      "manual",
      "voice",
      "receipt"
    ],
    "FlagType": [
      "red",
      "green",
      "none"
    ],
    "ReceiptStatus": [
      "processing",
      "saved",
      "needsReview",
      "failed",
      "discarded"
    ],
    "PeriodType": [
      "weekly",
      "monthly",
      "yearly",
      "custom"
    ],
    "RecurringType": [
      "expense",
      "income"
    ],
    "Frequency": [
      "once",
      "daily",
      "weekly",
      "monthly",
      "yearly"
    ],
    "DebtDirection": [
      "owedByMe",
      "owedToMe"
    ]
  },
  "collections": {
    "users/{uid}": {
      "fields": [
        "name",
        "email",
        "currencyCode",
        "currencySymbol",
        "reminder",
        "onboardingComplete",
        "openingBalance",
        "openingBalanceDay",
        "createdAt"
      ]
    },
    "users/{uid}/categories/{categoryId}": {
      "fields": [
        "name",
        "iconKey",
        "colorValue",
        "kind",
        "sortOrder",
        "archived"
      ]
    },
    "users/{uid}/budgets/{monthKey}": {
      "fields": [
        "monthKey",
        "income",
        "categories[{categoryId,name,iconKey,colorValue,kind,limit}]",
        "title",
        "periodType",
        "startDay",
        "endDay",
        "updatedAt"
      ],
      "note": "Doc id is the month key for a budget that is exactly one calendar month (the monthly report reads those); any other period gets a generated id. 'income' is the money budgeted for the period. startDay/endDay are inclusive 'yyyy-MM-dd'; old documents without them cover the whole month of monthKey."
    },
    "users/{uid}/expenses/{expenseId}": {
      "required": [
        "amount",
        "categoryId",
        "categoryName",
        "categoryKind",
        "note",
        "date",
        "dayKey",
        "monthKey",
        "source"
      ],
      "optional": [
        "transcript",
        "merchant",
        "confidence",
        "requestId",
        "receiptId",
        "recurringId",
        "items[{description,amount,quantity}]",
        "createdAt",
        "updatedAt"
      ],
      "rules": [
        "amount is an int > 0",
        "date is a timestamp",
        "note <= 500 chars"
      ]
    },
    "users/{uid}/monthStats/{monthKey}": {
      "fields": [
        "monthKey",
        "totalSpent",
        "flexibleSpent",
        "expenseCount",
        "spentByCategory{categoryId:int}",
        "spentByDay{dd:int}",
        "totalIncome",
        "incomeCount",
        "incomeByDay{dd:int}",
        "updatedAt"
      ],
      "invariant": "updated with increments in the SAME atomic commit as every expense add/edit/delete; only flexible categories add to flexibleSpent; income totals are updated the same way by every income add/edit/delete"
    },
    "users/{uid}/monthSummaries/{monthKey}": {
      "fields": [
        "monthKey",
        "income",
        "totalSpent",
        "flexibleSpent",
        "saved",
        "categories[{categoryId,name,limit,spent,flag}]",
        "suggestion",
        "report{headline,narrative,overspent[],saved[],improvements[],partial,generatedBy}",
        "generatedAt"
      ]
    },
    "users/{uid}/insights/{dayKey}": {
      "fields": [
        "dayKey",
        "message",
        "predictedSpend",
        "safeToSpend",
        "createdAt"
      ]
    },
    "users/{uid}/receipts/{receiptId}": {
      "fields": [
        "hasImage",
        "thumbnail",
        "mimeType",
        "sizeBytes",
        "status",
        "message",
        "merchant",
        "amount",
        "categoryId",
        "categoryName",
        "expenseId",
        "monthKey",
        "capturedAt",
        "uploadedAt",
        "updatedAt"
      ],
      "image": "the compressed JPEG is in users/{uid}/receiptImages/{receiptId} as {data: bytes, mimeType, sizeBytes, createdAt} (written by the app; the workflows never read it)",
      "note": "the receipt workflow sets status=saved, expenseId, amount, category and merchant in the same commit as the expense when it auto-saves"
    },
    "users/{uid}/incomes/{incomeId}": {
      "required": [
        "amount",
        "source",
        "note",
        "date",
        "dayKey",
        "monthKey"
      ],
      "optional": [
        "recurringId",
        "createdAt",
        "updatedAt"
      ],
      "rules": [
        "amount is an int > 0",
        "date is a timestamp",
        "source is 1-100 chars",
        "note <= 500 chars"
      ]
    },
    "users/{uid}/recurring/{recurringId}": {
      "required": [
        "title",
        "type",
        "amount",
        "frequency",
        "interval",
        "startDay",
        "nextDueDay",
        "autoRecord",
        "remindDays",
        "note",
        "active"
      ],
      "optional": [
        "categoryId",
        "categoryName",
        "categoryKind",
        "endDay",
        "lastPaidDay",
        "createdAt",
        "updatedAt"
      ],
      "rules": [
        "amount is an int > 0",
        "type is expense or income",
        "frequency is once, daily, weekly, monthly or yearly",
        "dates are 'yyyy-MM-dd' text"
      ],
      "note": "A bill, fee, rent or standing income. Paying it creates an expense or income with the id rec_{recurringId}_{dueDay} (so a due date is never recorded twice) and moves nextDueDay on in the same commit."
    },
    "users/{uid}/debts/{debtId}": {
      "required": [
        "direction",
        "person",
        "amount",
        "date",
        "dayKey",
        "note",
        "payments[{id,amount,date,note}]",
        "paidTotal",
        "affectsBalance"
      ],
      "optional": [
        "dueDay",
        "createdAt",
        "updatedAt"
      ],
      "rules": [
        "amount is an int > 0",
        "direction is owedByMe (I borrowed) or owedToMe (I lent)",
        "date is a timestamp",
        "payments is a list"
      ]
    }
  },
  "defaultCategories": [
    {
      "id": "food",
      "name": "Food & dining",
      "kind": "flexible"
    },
    {
      "id": "groceries",
      "name": "Groceries",
      "kind": "flexible"
    },
    {
      "id": "transport",
      "name": "Transport",
      "kind": "flexible"
    },
    {
      "id": "shopping",
      "name": "Shopping",
      "kind": "flexible"
    },
    {
      "id": "entertainment",
      "name": "Entertainment",
      "kind": "flexible"
    },
    {
      "id": "health",
      "name": "Health",
      "kind": "flexible"
    },
    {
      "id": "education",
      "name": "Education",
      "kind": "flexible"
    },
    {
      "id": "other",
      "name": "Other",
      "kind": "flexible"
    },
    {
      "id": "rent",
      "name": "Rent",
      "kind": "fixed"
    },
    {
      "id": "bills",
      "name": "Bills & utilities",
      "kind": "fixed"
    },
    {
      "id": "committee",
      "name": "Committee (kameti)",
      "kind": "fixed"
    },
    {
      "id": "savings",
      "name": "Savings",
      "kind": "savings"
    }
  ],
  "flags": {
    "redWhenOverLimit": 1.0,
    "greenWhenAtMostRatio": 0.85,
    "appliesTo": "categories with a limit > 0"
  }
}
